{
  "schema_version": 1,
  "python": "python",
  "tickets": {
    "globs": [
      "tickets/**/{id}.md",
      "tickets/**/ticket-{id}.md",
      "tickets/{id}.md"
    ],
    "new": {
      "path": "tickets/ticket-{id}.md",
      "id_format": "{n:03d}",
      "range_size": 100
    }
  },
  "kinds": {
    "enabled": [
      "code",
      "investigation",
      "comms",
      "docs",
      "tooling"
    ]
  },
  "protected_paths": [
    "src/"
  ],
  "test_paths": [
    "tests/"
  ],
  "placement": {
    "investigation": "docs/agent-notes/investigations",
    "comms": "docs/agent-notes/comms",
    "docs": "docs",
    "tooling": "scripts"
  },
  "plan_dir": ".atw/plans",
  "commands": {
    "proof": {
      "run": "{python} -m pytest -q -p no:cacheprovider --junitxml={junit} {ids}",
      "id_style": "pytest"
    },
    "tests": {
      "run": "{python} -m pytest -q -p no:cacheprovider {files}",
      "scope": "stem-match",
      "test_globs": [
        "test_*.py",
        "*_test.py"
      ],
      "source_globs": [
        "*.py"
      ]
    },
    "lint": {
      "run": "{python} -m ruff check --output-format json {files}",
      "output": "ruff-json",
      "file_globs": [
        "*.py"
      ],
      "changed_lines_only": true
    },
    "deps": {
      "builtin": "python-imports"
    }
  },
  "timeouts": {
    "command_seconds": 600
  },
  "simplify": "off",
  "audit": {
    "model": "opus",
    "route": "agent",
    "t3": {
      "provider": "codex",
      "model": "gpt-6.2-sol",
      "reasoning_effort": "medium"
    }
  },
  "verify": {
    "when": "big",
    "how": "npm run e2e (Playwright against the dev server with a mocked backend)",
    "min_planned_files": 8,
    "min_proof_ids": 8,
    "recheck_after_rounds": 2,
    "ignore": ["test-results/"]
  },
  "context": {
    "enabled": false,
    "index": "docs/agent-context/INDEX.md"
  },
  "guards": {
    "git": {
      "deny": ["reset-hard", "push-force", "rebase", "clean-force", "commit-amend"],
      "ask": ["push"]
    },
    "git_add_data": true,
    "test_delete": true,
    "deny": [],
    "ask": [],
    "protect_before_plan": true,
    "test_markers": [
      "(?<![\\w.$])(xit|xdescribe|xtest|xcontext|xspecify|fit|fdescribe|fcontext)\\s*\\(",
      "(?<![\\w.$])(it|describe|test|context|suite|specify)\\.(skip|only)\\b",
      "@pytest\\.mark\\.(skip|skipif|xfail)\\b",
      "\\bpytest\\.(skip|xfail)\\s*\\(",
      "@unittest\\.(skip|skipIf|skipUnless|expectedFailure)\\b"
    ]
  },
  "ste": {
    "enabled": false
  },
  "investigation": {
    "tools": [],
    "notes": ""
  },
  "jira": {
    "enabled": false,
    "site": "",
    "projects": [],
    "default_project": "",
    "start_transition": null,
    "in_progress_aliases": [],
    "import_dir": "tickets"
  }
}
