{
  "hosts": [
    "claude",
    "codex"
  ],
  "launcher": "python",
  "config": {
    "schema_version": 1,
    "python": "python",
    "tickets": {
      "globs": [
        "tickets/**/{id}.md",
        "tickets/{id}.md"
      ]
    },
    "kinds": {
      "enabled": [
        "code",
        "investigation",
        "comms",
        "docs",
        "tooling"
      ]
    },
    "protected_paths": [
      "src/"
    ],
    "test_paths": [
      "tests/"
    ],
    "placement": {
      "investigation": "docs/agent-notes/investigations",
      "comms": "docs/agent-notes/comms",
      "docs": "docs",
      "tooling": "scripts"
    },
    "plan_dir": ".atw/plans",
    "commands": {
      "proof": {
        "run": "{python} -m pytest -q -p no:cacheprovider --junitxml={junit} {ids}",
        "id_style": "pytest"
      },
      "tests": {
        "run": "{python} -m pytest -q -p no:cacheprovider {files}",
        "scope": "stem-match",
        "test_globs": [
          "test_*.py",
          "*_test.py"
        ],
        "source_globs": [
          "*.py"
        ]
      },
      "lint": {
        "run": "{python} -m ruff check --output-format json {files}",
        "output": "ruff-json",
        "file_globs": [
          "*.py"
        ],
        "changed_lines_only": true
      },
      "deps": {
        "builtin": "python-imports"
      }
    },
    "timeouts": {
      "command_seconds": 600
    },
    "simplify": "off",
    "audit": {
      "model": "opus"
    },
    "verify": {
      "when": "big",
      "how": "npm run e2e (Playwright against the dev server with a mocked backend)",
      "min_planned_files": 8,
      "min_proof_ids": 8,
      "recheck_after_rounds": 2,
      "ignore": ["test-results/"]
    },
    "context": {
      "enabled": false,
      "index": "docs/agent-context/INDEX.md"
    },
    "guards": {
      "git": {
        "deny": ["reset-hard", "push-force", "rebase", "clean-force", "commit-amend"],
        "ask": ["push"]
      },
      "git_add_data": true,
      "test_delete": true,
      "deny": [],
      "ask": [],
      "protect_before_plan": true
    },
    "ste": {
      "enabled": false
    },
    "investigation": {
      "tools": [],
      "notes": ""
    },
    "jira": {
      "enabled": false,
      "site": "",
      "projects": [],
      "default_project": "",
      "start_transition": null,
      "in_progress_aliases": [],
      "import_dir": "tickets"
    }
  },
  "skills": {
    "ticket-setup": "ticket-setup",
    "ticket": "ticket",
    "ticket-investigation": "ticket-investigation",
    "ticket-audit": "ticket-audit",
    "project-context-loading": null,
    "project-context-updating": null,
    "ste-writing": null,
    "jira": null
  },
  "skill_dirs": [
    ".claude/skills",
    ".agents/skills"
  ],
  "git_mode": null,
  "instructions": null,
  "claude_bridge": "auto",
  "claude_settings": null,
  "ignore": null,
  "ignore_extra": [],
  "context_index": "skip",
  "spike": null,
  "spike_dir": "docs/spikes",
  "overwrite_modified": [],
  "decisions": [
    {
      "item": "git_mode",
      "choice": "<local | commit - the user's answer>",
      "by": "user",
      "why": "<the user's reason>"
    },
    {
      "item": "hosts",
      "choice": "claude, codex",
      "by": "user",
      "why": "the team uses both"
    },
    {
      "item": "audit.model",
      "choice": "opus",
      "by": "agent",
      "why": "default; change audit.model to override"
    }
  ]
}
