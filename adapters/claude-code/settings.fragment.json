{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{python}}",
            "args": [
              "-c",
              "import os,runpy,sys;p=os.path.join(os.environ.get('CLAUDE_PROJECT_DIR','.'),*sys.argv[1].split('/'));sys.argv=sys.argv[1:];os.path.isfile(p) and runpy.run_path(p,run_name='__main__')",
              ".atw/core/atw.py",
              "hook",
              "stop"
            ],
            "timeout": 900,
            "statusMessage": "Checking ticket gates..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "{{python}}",
            "args": [
              "-c",
              "import os,runpy,sys;p=os.path.join(os.environ.get('CLAUDE_PROJECT_DIR','.'),*sys.argv[1].split('/'));sys.argv=sys.argv[1:];os.path.isfile(p) and runpy.run_path(p,run_name='__main__')",
              ".atw/core/atw.py",
              "hook",
              "guard"
            ],
            "timeout": 20
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "{{python}}",
            "args": [
              "-c",
              "import os,runpy,sys;p=os.path.join(os.environ.get('CLAUDE_PROJECT_DIR','.'),*sys.argv[1].split('/'));sys.argv=sys.argv[1:];os.path.isfile(p) and runpy.run_path(p,run_name='__main__')",
              ".atw/core/atw.py",
              "hook",
              "planmode"
            ],
            "timeout": 20
          }
        ]
      }
    ]
  }
}
