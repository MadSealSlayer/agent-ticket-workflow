{
  "name": "go-test",
  "area": "tests",
  "stack": "go",
  "requires": [
    "go",
    "gotestsum"
  ],
  "detect": {
    "files": [
      "go.mod"
    ]
  },
  "commands": {
    "proof": {
      "run": "gotestsum --junitfile {junit} -- ./...",
      "id_style": "name",
      "weak_patterns": [
        "undefined: ",
        "cannot find package",
        "\\[build failed\\]",
        "\\[setup failed\\]"
      ]
    },
    "tests": {
      "run": "go test ./...",
      "scope": "all"
    }
  },
  "notes": "Needs gotestsum (go install gotest.tools/gotestsum@latest). Proof ids are test names, e.g. TestParse/empty_input. The whole module runs."
}
